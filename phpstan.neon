includes:
    - vendor/cambis/silverstan/extension.neon

parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    # The setStatus() ignore below stops matching once a funnel-bearing core is resolved; don't fail the build then.
    reportUnmatchedIgnoredErrors: false
    silverstan:
        includeTestOnly: true
    ignoreErrors:
        # Order::setStatus() is the core funnel this module requires (silvershop/core ^6.2, PR #928). CI resolves the
        # pre-funnel 6.2.0 tag, so static analysis can't see it yet; runtime use is gated by ScheduledTransitionService::isDormant().
        -
            message: '#Call to an undefined method SilverShop\\Model\\Order::setStatus\(\)#'
            path: src/Service/ScheduledTransitionService.php
